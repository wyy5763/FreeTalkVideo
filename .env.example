# 1. Qwen / local OpenAI-compatible LLM
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3

# 2. CosyVoice3
# api: connect to an OpenAI-compatible local CosyVoice3 server
# native: load Fun-CosyVoice3 directly from the local CosyVoice checkout
TTS_MODE=api
TTS_BASE_URL=http://127.0.0.1:8080/v1
TTS_API_KEY=local
TTS_MODEL=cosyvoice3
TTS_VOICE=default

# Only used when TTS_MODE=native
COSYVOICE_ROOT=
COSYVOICE_PYTHON=python
COSYVOICE_MODEL_DIR=
COSYVOICE_PROMPT_WAV=
COSYVOICE_PROMPT_TEXT=
COSYVOICE_FP16=true

# 3. MuseTalk 1.5
MUSETALK_ROOT=
MUSETALK_PYTHON=python
MUSETALK_VERSION=v15
MUSETALK_GPU_ID=0
MUSETALK_BATCH_SIZE=8
MUSETALK_FLOAT16=true
MUSETALK_WHISPER_DIR=
MUSETALK_UNET_PATH=
MUSETALK_UNET_CONFIG=
MUSETALK_FFMPEG_PATH=

# 4. FFmpeg
FFMPEG_BIN=ffmpeg
OUTPUT_DIR=outputs
