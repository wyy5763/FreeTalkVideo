# FreeTalkVideo CPU-only baseline
# Hardware target: Intel i7-9700 + 32GB RAM + no NVIDIA GPU

LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:4b

TTS_MODE=native
TTS_BASE_URL=http://127.0.0.1:8080/v1
TTS_API_KEY=local
TTS_MODEL=cosyvoice3
TTS_VOICE=default

COSYVOICE_ROOT=G:/AI/CosyVoice
COSYVOICE_PYTHON=G:/AI/environments/cosyvoice/Scripts/python.exe
COSYVOICE_MODEL_DIR=G:/AI/Models/Fun-CosyVoice3-0.5B
COSYVOICE_PROMPT_WAV=G:/AI/CosyVoice/asset/zero_shot_prompt.wav
COSYVOICE_PROMPT_TEXT=You are a helpful assistant.<|endofprompt|>希望你以后能够做的比我还好呦。
COSYVOICE_FP16=false

MUSETALK_ENABLED=false
MUSETALK_ROOT=
MUSETALK_PYTHON=python
MUSETALK_VERSION=v15
MUSETALK_GPU_ID=0
MUSETALK_BATCH_SIZE=1
MUSETALK_FLOAT16=false
MUSETALK_WHISPER_DIR=
MUSETALK_UNET_PATH=
MUSETALK_UNET_CONFIG=
MUSETALK_FFMPEG_PATH=

FFMPEG_BIN=ffmpeg
OUTPUT_DIR=G:/AI/FreeTalkVideo/outputs
